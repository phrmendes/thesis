digraph sql_lineage {
    rankdir = TB;
    nodesep = 0.5;
    ranksep = 0.7;
    splines = spline;
    node [shape = box, style = "rounded,filled", fontname = "Helvetica", fontsize = 12];
    edge [arrowhead = vee, color = "#555555"];

    subgraph cluster_sources {
        label = "Fontes de dados";
        style = "rounded,filled";
        color = "#e8e8e8";
        fillcolor = "#f5f5f5";
        api_prices [label = "API de preços\n(csgotrader)", shape = cylinder];
        api_items [label = "Metadados de itens\n(ByMykel)", shape = cylinder];
    }

    subgraph cluster_raw {
        label = "raw";
        style = "rounded,filled";
        color = "#fde9e0";
        fillcolor = "#fde9e0";
        raw_prices [label = "raw.prices\n(ativo x dia)"];
        raw_items [label = "raw.items\n(raridade)"];
    }

    subgraph cluster_cleaned {
        label = "cleaned";
        style = "rounded,filled";
        color = "#e3f2fd";
        fillcolor = "#e3f2fd";
        cleaned_prices [label = "cleaned.prices\n(ativo x semana)"];
    }

    subgraph cluster_portfolios {
        label = "portfolios";
        style = "rounded,filled";
        color = "#e8f5e9";
        fillcolor = "#e8f5e9";
        buy_and_hold [label = "portfolios.buy_and_hold\n(carteira x semana teste)"];
    }

    subgraph cluster_eda {
        label = "Análise (EDA)";
        style = "rounded,filled";
        color = "#f3e5f5";
        fillcolor = "#f3e5f5";
        eda [label = "Tabelas LaTeX\nretornos, cobertura, qualidade"];
    }

    api_prices -> raw_prices [label = "importar diário"];
    api_items -> raw_items [label = "importar metadados"];
    raw_items -> raw_prices [label = "unir raridade"];

    raw_prices -> cleaned_prices [label = "seleção e agregação semanal"];

    cleaned_prices -> eda [label = "derivar retornos"];
    cleaned_prices -> buy_and_hold [label = "preço semanal fechamento"];

    // cleaning rule annotations
    rule_sel [shape = note, style = "rounded,filled", fillcolor = "#fff8e1", label = "Regras\n• preço médio >= 1\n• >= 500 observações\n• preço de fechamento semanal\n• retorno limitado a +/-100%"];
    rule_strategy [shape = note, style = "rounded,filled", fillcolor = "#fff8e1", label = "Buy-and-hold\n• 70% seleção histórica\n• 30% teste\n• pesos iniciais iguais\n• sem rebalanceamento\n• taxa de 10% na venda final"];

    raw_prices -> rule_sel [style = dashed, constraint = false];
    cleaned_prices -> rule_strategy [style = dashed, constraint = false];
}
